# =============================================================================
# SafeMap AI Frontend Environment Configuration Reference
# =============================================================================

# Base URL for the SafeMap AI FastAPI backend service
# In local development: http://127.0.0.1:8000
# In Docker Compose deployment: http://localhost:8000 or http://backend:8000
# In production: https://api.yourdomain.org (must match backend CORS_ORIGINS)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional Google Maps JavaScript API Key (client-side map tiles)
# Leave empty to utilize built-in OpenStreetMap / Leaflet tile layers.
# WARNING: NEVER place private backend credentials, ADMIN_API_KEY, or server secrets here!
VITE_GOOGLE_MAPS_API_KEY=

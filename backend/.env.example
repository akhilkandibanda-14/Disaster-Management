# =============================================================================
# SafeMap AI Backend Environment Configuration Reference
# Milestone 10: Deployment Readiness and Security Hardening
# =============================================================================

# Deployment Environment: development | demonstration | staging | production
# In 'production', DEMO_MODE defaults to false unless explicitly overridden.
APP_ENV=development
DEMO_MODE=true

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Connection (PostgreSQL 16 + PostGIS 3.4)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/disaster_management
DATABASE_POOL_SIZE=5

# External Telemetry & API Credentials
# WEATHER_API_KEY: OpenWeather API key (https://openweathermap.org/api)
# Also accepts OPENWEATHER_API_KEY.
# Leave empty to use simulated demo telemetry (clearly labeled [DEMO]).
WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# Administrative & Analyst Access Keys (Role-Based Access Control)
# WARNING: Change these keys immediately before deploying to staging/production!
# Do NOT commit production keys to version control.
ADMIN_API_KEY=safemap-admin-dev-key
ANALYST_API_KEY=safemap-analyst-dev-key

# Permitted Cross-Origin Resource Sharing (CORS) Origins
# Formats accepted: JSON array or comma-separated string
# Example: CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://safemap.example.gov"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Operational Logging & Observability
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT: json (recommended for production log aggregators) | text (for local dev)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Machine Learning Artifact & Dataset Storage Paths
FLOOD_DATASET_PATH=ml/data/flood_dataset.csv
FLOOD_MODEL_PATH=ml/models/flood_risk_model.joblib
